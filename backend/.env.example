# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is git-ignored; this example file is committed.

# Required for the real LLM planner and llm_step nodes.
# Without it, the app and tests run on deterministic offline stubs.
NVIDIA_API_KEY=

# --- optional overrides (defaults shown) ---
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_ENABLE_THINKING=false
# PLANNER_BACKEND=auto
# PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# EXECUTOR_LLM_BACKEND=auto
# EXECUTOR_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# PLANNER_MAX_REPAIR_ATTEMPTS=2
# EXECUTOR_HTTP_TIMEOUT=15
# EXECUTOR_MAX_RESPONSE_BYTES=1000000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
